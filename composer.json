{
    "name": "route-connex/route-connex-sdk-php",
    "description": "PHP SDK for RouteConnex API",
    "type": "library",
    "license": "MIT",
    "version": "1.2.0",
    "authors": [
        {
            "name": "Leo Oberle",
            "email": "leocello@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1.0",
        "guzzlehttp/guzzle": "^7.9 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.36",
        "laravel/pint": "^1.20",
        "vlucas/phpdotenv": "^5.6",
        "symfony/var-dumper": "^6.4"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-z3gr-8qht-p93v": "CVE-2026-24765 (phpunit/phpunit <10.5.62, PHPT code coverage). Pest 2.36.0, the last release supporting PHP 8.1, pins phpunit/phpunit to 10.5.36. Dev-only; this project has no PHPT tests."
                }
            }
        }
    },
    "autoload": {
        "psr-4": {
            "RouteConnex\\RouteConnexSdkPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RouteConnex\\RouteConnexSdkPhp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "test": "pest"
    }
}
